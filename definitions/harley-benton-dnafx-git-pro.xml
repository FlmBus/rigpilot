<!-- Harley Benton DNAfx GiT Pro - RigPilot Device Definition -->
<DeviceDefinition id="harley-benton-dnafx-git-pro" version="1.0"
                  xmlns="https://rigpilot.app/schemas/device-definition/1">
  <Meta>
    <Manufacturer>Harley Benton</Manufacturer>
    <Model>DNAfx GiT Pro</Model>
    <Author>Flemming Busman</Author>
    <Source>Thomann user manual ID 517099 (11.01.2022), sections MIDI SETTING / PC Mapping / CC Reference</Source>
    <Description>In MENU > MIDI SETTING: direction must be 'MIDI IN' (default), and the channel (default 1) must match the channel configured in RigPilot's Device Settings. Value semantics were verified on hardware: the CCs are value-switched (127 = on, 0 = off), so every command below (except the pedal position sweeps) carries an On/Off State parameter. Note: the "Select Preset (33A-64D)" bank suffers from a device firmware bug where several slots load the wrong preset - this is a hardware defect, not a definition issue.</Description>
  </Meta>

