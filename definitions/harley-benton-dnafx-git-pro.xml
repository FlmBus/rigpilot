    </OneShot>

    <!-- ============ Pedals ============ -->

    <Hold id="pedal-1-active" name="Pedal 1 Active" group="Pedals"
             description="Expression pedal 1 is active for the duration of the block.">
      <Engage><ControlChange controller="51" value="127"/></Engage>
      <Disengage><ControlChange controller="51" value="0"/></Disengage>
    </Hold>
    <Automation id="pedal-1" name="Pedal 1 Position" group="Pedals"
             description="Expression pedal 1 position.">
      <Target controller="52"/>
    </Automation>
    <Automation id="pedal-2" name="Pedal 2 Position" group="Pedals"
             description="Expression pedal 2 position.">
      <Target controller="53"/>
    </Automation>

    <!-- ============ Misc ============ -->

    <OneShot id="tap-tempo" name="Tap Tempo" group="Misc"
             description="A single tempo tap. Place several in a row to set the tempo.">
      <ControlChange controller="25" value="127"/>
    </OneShot>
    <Hold id="tuner" name="Tuner" group="Misc"
             description="Tuner is shown for the duration of the block.">
      <Engage><ControlChange controller="27" value="127"/></Engage>
      <Disengage><ControlChange controller="27" value="0"/></Disengage>
    </Hold>

    <!-- ============ Looper &amp; Rhythm ============ -->

    <Hold id="looper" name="Looper" group="Looper &amp; Rhythm"
             description="Looper view is open for the duration of the block.">
      <Engage><ControlChange controller="26" value="127"/></Engage>
      <Disengage><ControlChange controller="26" value="0"/></Disengage>
    </Hold>
    <OneShot id="looper-rec-dub" name="Looper Rec/Dub" group="Looper &amp; Rhythm" deterministic="false"
             description="Starts recording or overdubbing - depends on the looper's current state.">
      <ControlChange controller="28" value="127"/>
    </OneShot>
    <OneShot id="looper-play" name="Looper Play" group="Looper &amp; Rhythm"
             description="Starts looper playback.">
      <ControlChange controller="46" value="127"/>
    </OneShot>
    <OneShot id="looper-stop" name="Looper Stop" group="Looper &amp; Rhythm"
             description="Stops looper playback.">
      <ControlChange controller="47" value="127"/>
    </OneShot>
    <OneShot id="looper-clear" name="Looper Clear" group="Looper &amp; Rhythm"
             description="Clears the recorded loop.">
      <ControlChange controller="48" value="127"/>
    </OneShot>
    <Hold id="rhythm" name="Rhythm" group="Looper &amp; Rhythm"
             description="Rhythm (drum machine) runs for the duration of the block.">
      <Engage><ControlChange controller="49" value="127"/></Engage>
      <Disengage><ControlChange controller="49" value="0"/></Disengage>
    </Hold>
    <OneShot id="rhythm-tap" name="Rhythm Tap" group="Looper &amp; Rhythm"
             description="A single rhythm tempo tap.">
      <ControlChange controller="50" value="127"/>
    </OneShot>

