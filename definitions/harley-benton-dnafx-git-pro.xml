      <Disengage><ControlChange controller="20" value="0"/></Disengage>
    </Hold>

    <!-- ============ Footswitches ============
         VERIFY: footswitch CCs likely emulate a physical press (toggle). -->

    <OneShot id="footswitch-a" name="Footswitch A" group="Footswitches" deterministic="false"
             description="Emulates pressing footswitch A - effect depends on the current footswitch mode.">
      <ControlChange controller="21" value="127"/>
    </OneShot>
    <OneShot id="footswitch-b" name="Footswitch B" group="Footswitches" deterministic="false"
             description="Emulates pressing footswitch B - effect depends on the current footswitch mode.">
      <ControlChange controller="22" value="127"/>
    </OneShot>
    <OneShot id="footswitch-c" name="Footswitch C" group="Footswitches" deterministic="false"
             description="Emulates pressing footswitch C - effect depends on the current footswitch mode.">
      <ControlChange controller="23" value="127"/>
