    <!-- ============ Modules ============
         VERIFY value semantics (see header). -->

    <Hold id="module-dynamic" name="Dynamic Module" group="Modules"
             description="Dynamic module is ON for the duration of the block, OFF afterwards.">
      <Engage><ControlChange controller="10" value="127"/></Engage>
      <Disengage><ControlChange controller="10" value="0"/></Disengage>
    </Hold>
    <Hold id="module-wah" name="Wah Module" group="Modules"
             description="Wah module is ON for the duration of the block, OFF afterwards.">
      <Engage><ControlChange controller="11" value="127"/></Engage>
      <Disengage><ControlChange controller="11" value="0"/></Disengage>
    </Hold>
    <Hold id="module-ds" name="Distortion (DS) Module" group="Modules"
             description="Distortion module is ON for the duration of the block, OFF afterwards.">
      <Engage><ControlChange controller="12" value="127"/></Engage>
      <Disengage><ControlChange controller="12" value="0"/></Disengage>
    </Hold>
    <Hold id="module-amp" name="Amp Module" group="Modules"
             description="Amp module is ON for the duration of the block, OFF afterwards.">
      <Engage><ControlChange controller="13" value="127"/></Engage>
      <Disengage><ControlChange controller="13" value="0"/></Disengage>
    </Hold>
    <Hold id="module-cab" name="Cab Module" group="Modules"
