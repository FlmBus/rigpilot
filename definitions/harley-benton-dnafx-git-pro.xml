<!-- Harley Benton DNAfx GiT Pro - RigPilot Device Definition -->
<DeviceDefinition id="harley-benton-dnafx-git-pro" version="1.0"
                  xmlns="https://rigpilot.app/schemas/device-definition/1">
  <Meta>
    <Manufacturer>Harley Benton</Manufacturer>
    <Model>DNAfx GiT Pro</Model>
    <Author>Flemming Busman</Author>
    <Source>Thomann user manual ID 517099 (11.01.2022), sections MIDI SETTING / PC Mapping / CC Reference</Source>
    <Description>In MENU > MIDI SETTING: direction must be 'MIDI IN' (default), and the channel (default 1) must match the channel configured in RigPilot's Device Settings. VERIFY ON HARDWARE: the manual lists the ON/OFF CCs (10-20, 49, 51) and footswitch CCs (21-24) with value range 0-127 without defining the semantics. The Hold commands assume value-switched behavior (0 = off, 127 = on); if they turn out to be edge-triggered toggles, remodel them as non-deterministic One-Shots.</Description>
  </Meta>

