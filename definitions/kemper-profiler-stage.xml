    </Hold>

    <Hold id="stomp-mod" name="Stomp MOD" group="Stomps"
             description="Stomp MOD is ON for the duration of the block, OFF afterwards (absolute switching via NRPN).">
      <Engage>
        <ControlChange controller="99" value="58"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
        <ControlChange controller="99" value="58"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="0"/>
      </Disengage>
    </Hold>

    <Hold id="stomp-delay" name="Stomp DELAY" group="Stomps"
             description="Stomp DELAY is ON for the duration of the block, OFF afterwards (absolute switching via NRPN).">
      <Engage>
        <ControlChange controller="99" value="60"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
        <ControlChange controller="99" value="60"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="0"/>
      </Disengage>
    </Hold>

    <!-- Toggle variants (state-dependent — prefer the Holds above for shows) -->
    <OneShot id="toggle-all-stomps" name="Toggle All Stomps" group="Stomps" deterministic="false"
             description="Flips ALL stomps on/off relative to their current state. Prefer the Stomp blocks for predictable shows.">
      <ControlChange controller="16" value="1"/>
    </OneShot>
    <OneShot id="toggle-delay-tail" name="Toggle DELAY (with tail)" group="Stomps" deterministic="false"
             description="Flips the DELAY stomp, letting the delay tail ring out. State-dependent.">
      <ControlChange controller="27" value="1"/>
    </OneShot>
    <OneShot id="toggle-reverb" name="Toggle Reverb" group="Stomps" deterministic="false"
             description="Flips the reverb on/off relative to its current state.">
      <ControlChange controller="28" value="1"/>
    </OneShot>
    <OneShot id="toggle-reverb-tail" name="Toggle Reverb (with tail)" group="Stomps" deterministic="false"
             description="Flips the reverb, letting the reverb tail ring out. State-dependent.">
      <ControlChange controller="29" value="1"/>
    </OneShot>

    <!-- ============ Effects ============ -->

    <Hold id="rotary-fast" name="Rotary Speaker Fast" group="Effects"
             description="Rotary speaker runs FAST for the duration of the block, slow afterwards.">
      <Engage><ControlChange controller="33" value="1"/></Engage>
      <Disengage><ControlChange controller="33" value="0"/></Disengage>
    </Hold>

    <Hold id="delay-infinity" name="Delay Feedback Infinity" group="Effects"
             description="Delay feedback is set to infinity for the duration of the block.">
      <Engage><ControlChange controller="34" value="1"/></Engage>
      <Disengage><ControlChange controller="34" value="0"/></Disengage>
    </Hold>

    <Hold id="delay-hold" name="Delay Hold" group="Effects"
             description="Delay hold (freeze) is active for the duration of the block.">
      <Engage><ControlChange controller="35" value="1"/></Engage>
      <Disengage><ControlChange controller="35" value="0"/></Disengage>
    </Hold>

    <Automation id="delay-mix" name="Delay Mix" group="Effects"
             description="Continuous control over the delay mix.">
      <Target controller="68"/>
    </Automation>
    <Automation id="delay-feedback" name="Delay Feedback" group="Effects"
             description="Continuous control over the delay feedback.">
      <Target controller="69"/>
    </Automation>
    <Automation id="reverb-mix" name="Reverb Mix" group="Effects"
             description="Continuous control over the reverb mix.">
      <Target controller="70"/>
    </Automation>
    <Automation id="reverb-time" name="Reverb Time" group="Effects"
             description="Continuous control over the reverb time.">
      <Target controller="71"/>
    </Automation>
    <Automation id="amp-gain" name="Amp Gain" group="Effects"
             description="Continuous control over the amplifier gain.">
      <Target controller="72"/>
    </Automation>

    <!-- ============ Pedals ============ -->

    <Automation id="wah-pedal" name="Wah Pedal" group="Pedals"
             description="Wah pedal position (like rocking a connected wah pedal).">
      <Target controller="1"/>
    </Automation>
    <Automation id="pitch-pedal" name="Pitch Pedal" group="Pedals"
             description="Pitch pedal position.">
      <Target controller="4"/>
    </Automation>
    <Automation id="volume-pedal" name="Volume Pedal" group="Pedals"
             description="Volume pedal position.">
      <Target controller="7"/>
    </Automation>
    <Automation id="morph-pedal" name="Morph Pedal" group="Pedals"
             description="Morph pedal position (blends between the rig's two morph states).">
      <Target controller="11"/>
    </Automation>

    <!-- ============ Misc ============ -->

    <!-- Single tap event. (For the Beat Scanner, send 1 and hold off the 0.) -->
    <OneShot id="tap-tempo" name="Tap Tempo" group="Misc"
             description="A single tempo tap. Place several in a row to set the tempo.">
      <ControlChange controller="30" value="0"/>
    </OneShot>

    <Hold id="show-tuner" name="Show Tuner" group="Misc"
             description="Shows the tuner for the duration of the block.">
      <Engage><ControlChange controller="31" value="1"/></Engage>
      <Disengage><ControlChange controller="31" value="0"/></Disengage>
    </Hold>

    <Automation id="monitor-volume" name="Monitor Output Volume" group="Misc"
             description="Continuous control over the global monitor output volume.">
      <Target controller="73"/>
    </Automation>

  </Commands>
</DeviceDefinition>
