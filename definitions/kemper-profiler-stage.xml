        <ControlChange controller="99" value="53"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
        <ControlChange controller="99" value="53"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="0"/>
      </Disengage>
    </Hold>

    <Hold id="stomp-x" name="Stomp X" group="Stomps"
             description="Stomp X is ON for the duration of the block, OFF afterwards (absolute switching via NRPN).">
      <Engage>
        <ControlChange controller="99" value="56"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
