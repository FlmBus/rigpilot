<?xml version="1.0" encoding="UTF-8"?>
<!-- Kemper Profiler Stage - RigPilot Device Definition -->
<DeviceDefinition id="kemper-profiler-stage" version="1.0"
                  xmlns="https://rigpilot.app/schemas/device-definition/1">
  <Meta>
    <Manufacturer>Kemper</Manufacturer>
    <Model>Profiler Stage</Model>
    <Author>Flemming Busman</Author>
    <Source>Profiler MIDI Parameter Documentation rev. 145 (fw 4.2.1+)</Source>
    <Source>Kemper Main Manual (pedal controllers CC1/4/7/11)</Source>
    <Description>Set the Profiler's "MIDI Global Channel" (System Menu, default OMNI) to the MIDI channel configured in RigPilot's Device Settings. Stomp commands switch deterministically via NRPN; the plain toggle CCs are also included, but their result depends on the device's current state.</Description>
  </Meta>

  <Commands>

    <!-- ============ Performances ============ -->

