    <OneShot id="load-slot-1" name="Load Slot 1" short="Slot 1" group="Performances"
             description="Loads slot 1 of the preselected (or current) performance.">
      <ControlChange controller="50" value="1"/>
    </OneShot>
    <OneShot id="load-slot-2" name="Load Slot 2" short="Slot 2" group="Performances"
             description="Loads slot 2 of the preselected (or current) performance.">
      <ControlChange controller="51" value="1"/>
    </OneShot>
    <OneShot id="load-slot-3" name="Load Slot 3" short="Slot 3" group="Performances"
             description="Loads slot 3 of the preselected (or current) performance.">
      <ControlChange controller="52" value="1"/>
    </OneShot>
    <OneShot id="load-slot-4" name="Load Slot 4" short="Slot 4" group="Performances"
             description="Loads slot 4 of the preselected (or current) performance.">
      <ControlChange controller="53" value="1"/>
    </OneShot>
    <OneShot id="load-slot-5" name="Load Slot 5" short="Slot 5" group="Performances"
             description="Loads slot 5 of the preselected (or current) performance.">
      <ControlChange controller="54" value="1"/>
    </OneShot>

    <!-- Relative navigation: result depends on the current performance. -->
    <OneShot id="performance-up" name="Performance Up" group="Performances" deterministic="false"
             description="Steps to the next performance - relative, depends on where the device currently is.">
      <ControlChange controller="48" value="0"/>
    </OneShot>
    <OneShot id="performance-down" name="Performance Down" group="Performances" deterministic="false"
             description="Steps to the previous performance - relative, depends on where the device currently is.">
      <ControlChange controller="49" value="0"/>
    </OneShot>

    <!-- ============ Stomps (deterministic, via NRPN) ============
         Plain CCs 16-29 only TOGGLE the stomps (state-dependent!).
         Absolute on/off goes through NRPN: CC99 = address page,
         CC98 = parameter number (3 = On/Off), CC6/CC38 = 14-bit value.   -->

    <Hold id="stomp-a" name="Stomp A" group="Stomps"
             description="Stomp A is ON for the duration of the block, OFF afterwards (absolute switching via NRPN).">
      <Engage>
        <ControlChange controller="99" value="50"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
        <ControlChange controller="99" value="50"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="0"/>
      </Disengage>
    </Hold>

    <Hold id="stomp-b" name="Stomp B" group="Stomps"
             description="Stomp B is ON for the duration of the block, OFF afterwards (absolute switching via NRPN).">
      <Engage>
        <ControlChange controller="99" value="51"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
        <ControlChange controller="99" value="51"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="0"/>
      </Disengage>
    </Hold>

    <Hold id="stomp-c" name="Stomp C" group="Stomps"
             description="Stomp C is ON for the duration of the block, OFF afterwards (absolute switching via NRPN).">
      <Engage>
        <ControlChange controller="99" value="52"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="1"/>
      </Engage>
      <Disengage>
        <ControlChange controller="99" value="52"/>
        <ControlChange controller="98" value="3"/>
        <ControlChange controller="6"  value="0"/>
        <ControlChange controller="38" value="0"/>
      </Disengage>
    </Hold>

    <Hold id="stomp-d" name="Stomp D" group="Stomps"
