<?xml version="1.0" encoding="UTF-8"?>
<!-- Neural DSP Quad Cortex (CorOS 4.x) - RigPilot Device Definition -->
<DeviceDefinition id="neural-dsp-quad-cortex-coros4" version="1.0"
                  xmlns="https://rigpilot.app/schemas/device-definition/1">
  <Meta>
    <Manufacturer>Neural DSP</Manufacturer>
    <Model>Quad Cortex (CorOS 4.x)</Model>
    <Author>Flemming Busman</Author>
    <Source>Quad Cortex User Manual 4.0.0</Source>
    <Description>Set the Quad Cortex MIDI channel (Settings > Device > MIDI) to the channel configured in RigPilot's Device Settings. VERIFY ON HARDWARE: (1) the exact bank/setlist arithmetic of "Select Preset" (CC0/CC32 + PC) - cross-check with Neural's MIDI PC Calculator, CorOS versions have differed here; (2) the value semantics of footswitch CCs 35-42 (assumed 0-63 = bypass, 64-127 = enable).</Description>
  </Meta>

  <Commands>

    <!-- ============ Presets &amp; Scenes ============ -->

    <!-- VERIFY: bank values vs. setlist numbering (see header). Raw form until then. -->
    <OneShot id="select-preset" name="Select Preset (raw bank + PC)" short="Preset" group="Presets &amp; Scenes"
             description="Loads a preset by raw bank values + program number. UNVERIFIED bank arithmetic - check against Neural's MIDI PC Calculator.">
      <Param id="bank-msb" name="Bank MSB (CC0)" min="0" max="127" default="0"/>
      <Param id="bank-lsb" name="Bank LSB (CC32)" min="0" max="127" default="0"/>
      <Param id="program" name="Program #" min="0" max="127" default="0"/>
      <ControlChange controller="0" value="$bank-msb"/>
      <ControlChange controller="32" value="$bank-lsb"/>
      <ProgramChange program="$program"/>
    </OneShot>

    <OneShot id="select-scene" name="Select Scene" short="Scene" group="Presets &amp; Scenes"
             description="Switches to scene A-H of the current preset.">
      <Param id="scene" name="Scene" min="0" max="7" default="0">
        <Label value="0">A</Label>
        <Label value="1">B</Label>
        <Label value="2">C</Label>
        <Label value="3">D</Label>
        <Label value="4">E</Label>
        <Label value="5">F</Label>
        <Label value="6">G</Label>
        <Label value="7">H</Label>
      </Param>
      <ControlChange controller="43" value="$scene"/>
    </OneShot>

    <OneShot id="set-mode" name="Set Mode" short="Mode" group="Presets &amp; Scenes"
             description="Switches the footswitch layout between Preset, Scene and Stomp mode.">
      <Param id="mode" name="Mode" min="0" max="2" default="0">
        <Label value="0">Preset Mode</Label>
        <Label value="1">Scene Mode</Label>
        <Label value="2">Stomp Mode</Label>
      </Param>
      <ControlChange controller="47" value="$mode"/>
    </OneShot>

    <!-- ============ Footswitches ============
         VERIFY value semantics (assumed 64-127 = enable, 0-63 = bypass). -->

    <OneShot id="footswitch-a" name="Footswitch A" group="Footswitches"
             description="Enables or bypasses Footswitch A.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="35" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-b" name="Footswitch B" group="Footswitches"
             description="Enables or bypasses Footswitch B.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="36" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-c" name="Footswitch C" group="Footswitches"
             description="Enables or bypasses Footswitch C.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="37" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-d" name="Footswitch D" group="Footswitches"
             description="Enables or bypasses Footswitch D.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="38" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-e" name="Footswitch E" group="Footswitches"
             description="Enables or bypasses Footswitch E.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="39" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-f" name="Footswitch F" group="Footswitches"
             description="Enables or bypasses Footswitch F.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="40" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-g" name="Footswitch G" group="Footswitches"
             description="Enables or bypasses Footswitch G.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="41" value="$state"/>
    </OneShot>
    <OneShot id="footswitch-h" name="Footswitch H" group="Footswitches"
             description="Enables or bypasses Footswitch H.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="On">Enable</Label>
        <Label value="0" short="Off">Bypass</Label>
      </Param>
      <ControlChange controller="42" value="$state"/>
    </OneShot>

    <!-- ============ Pedals ============ -->

    <Automation id="expression-1" name="Expression Pedal 1" group="Pedals"
             description="Expression pedal 1 position.">
      <Target controller="1"/>
    </Automation>
    <Automation id="expression-2" name="Expression Pedal 2" group="Pedals"
             description="Expression pedal 2 position.">
      <Target controller="2"/>
    </Automation>

    <!-- ============ Misc ============ -->

    <OneShot id="tap-tempo" name="Tap Tempo" group="Misc"
             description="A single tempo tap. Place several in a row to set the tempo.">
      <ControlChange controller="44" value="127"/>
    </OneShot>

    <OneShot id="tuner" name="Tuner" group="Misc"
             description="Shows or hides the tuner.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="Show">Show</Label>
        <Label value="0" short="Hide">Hide</Label>
      </Param>
      <ControlChange controller="45" value="$state"/>
    </OneShot>

    <OneShot id="gig-view" name="Gig View" group="Misc"
             description="Shows or hides Gig View.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="Show">Show</Label>
        <Label value="0" short="Hide">Hide</Label>
      </Param>
      <ControlChange controller="46" value="$state"/>
    </OneShot>

    <OneShot id="ignore-duplicate-pc-on" name="Ignore Duplicate PC: On" group="Misc"
             description="Makes the device ignore repeated identical Program Changes.">
      <ControlChange controller="62" value="127"/>
    </OneShot>
    <OneShot id="ignore-duplicate-pc-off" name="Ignore Duplicate PC: Off" group="Misc"
             description="Makes the device process repeated identical Program Changes again.">
      <ControlChange controller="62" value="0"/>
    </OneShot>

    <!-- ============ Looper X ============ -->

    <OneShot id="looper-open" name="Looper X Open/Close" short="Looper X" group="Looper"
             description="Opens or closes the Looper X view.">
      <Param id="state" name="State" min="0" max="127" default="127">
        <Label value="127" short="Open">Open</Label>
        <Label value="0" short="Close">Close</Label>
      </Param>
      <ControlChange controller="48" value="$state"/>
    </OneShot>

  </Commands>
</DeviceDefinition>
