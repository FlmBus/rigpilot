    <!-- Blinder fade time, repurposing CC5 (Portamento Time), full 0-127 range.
         The QLC+ show scales this to 0 ms - 5000 ms (0 = instant, 127 = 5000 ms).
         Automation so the fade time can be swept over the song as a value curve. -->
    <Automation id="blinder-fade-time" name="Blinder Fade-Time" short="Fade" group="Blinders"
             description="Blinder fade time via CC5 (Portamento Time) as a 0-127 value curve, scaled to 0 ms - 5000 ms in the QLC+ show (0 = instant, 127 = 5000 ms).">
      <Target controller="5" min="0" max="127"/>
    </Automation>

